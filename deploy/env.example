# Skopiuj do deploy/.env i uzupełnij. Plik .env nie trafia do repozytorium.

# Tryb nginx:
#   http  - HTTPS zapewnia zewnętrzne proxy (np. subdomena mikr.us, Cloudflare)
#           albo testy lokalne
#   https - własna domena + Let's Encrypt (wymaga portów 80 i 443 tego serwera)
#   cloudflare - jak https, ale za proxy Cloudflare: prawdziwy adres klienta z
#           CF-Connecting-IP, połączenia spoza Cloudflare odrzucane.
#           Na mikr.us: HTTP_BIND=[::]:80, HTTPS_BIND=[::]:443 (własne IPv6)
NGINX_MODE=http

# Domena API, np. api.example.pl (w trybie https wymagana)
DOMAIN=localhost

# Gdzie nginx nasłuchuje na hoście. Domyślnie tylko lokalnie (nic nie jest
# wystawione do internetu). Przykłady: 0.0.0.0:80, [::]:80, 0.0.0.0:30316
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443

# Adresy zaufanego proxy przed nginx (tryb http), z których bierzemy prawdziwy
# adres klienta. Bez proxy zostaw 127.0.0.1/32.
REAL_IP_FROM=127.0.0.1/32

# Adresy strony z testami, rozdzielone przecinkami
ALLOWED_ORIGIN=https://azmuthszym.github.io
RATE_LIMIT=20
KEEP_DAYS=14
